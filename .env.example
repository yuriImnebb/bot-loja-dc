# Copie este arquivo para ".env" e preencha os valores.

# Token do bot (Discord Developer Portal > sua aplicacao > Bot > Reset Token)
BOT_TOKEN=cole_o_token_do_bot_aqui

# Banco de dados. Deixe comentado para usar o SQLite local em ./data/lojas.db
# DATABASE_URL=sqlite+aiosqlite:///data/lojas.db

# API interna (usada no futuro para webhooks de pagamento automatico)
API_ENABLED=true
API_HOST=0.0.0.0
API_PORT=8000

# Opcional: IDs de servidores de teste. Preenchido, os comandos aparecem NA HORA
# nesses servidores (em vez de esperar ate 1h pela sincronizacao global).
# Exemplo: 123456789012345678,987654321098765432
DEV_GUILD_IDS=

# VOCE: seu ID de usuario no Discord. Quem estiver aqui usa os comandos /master
# (ver todas as lojas, mudar plano, bloquear/liberar). Pegue o seu em:
# Discord > Configuracoes > Avancado > Modo desenvolvedor, depois clique com o
# botao direito no seu nome > Copiar ID.
# Exemplo: 123456789012345678
OWNER_IDS=

# Segredo do webhook de licencas. Invente uma senha longa e use a MESMA no seu
# gateway de pagamento, enviando no cabecalho "x-webhook-secret".
WEBHOOK_SECRET=

# --------------------------------------------------------------------------- #
# Cobranca das assinaturas (PIX via Mercado Pago, caindo direto na sua conta)
# --------------------------------------------------------------------------- #
# Token de PRODUCAO da SUA conta Mercado Pago (sua conta de vendedor).
# Pegue em: mercadopago.com.br > Seu negocio > Configuracoes > Credenciais >
# Credenciais de producao > Access Token (comeca com APP_USR-...).
# Os PIX dos seus clientes caem direto nessa conta.
MERCADOPAGO_ACCESS_TOKEN=

# Opcional: URL publica desta API (para o Mercado Pago avisar o pagamento na
# hora). Sem isso o bot tambem funciona: ele confere os pagamentos a cada 2 min.
# Ex: https://meu-bot.seudominio.com
PUBLIC_URL=

# Preco mensal de cada plano, em centavos (2990 = R$ 29,90).
PLANO_MEDIA_PRECO_CENTAVOS=2990
PLANO_PRO_PRECO_CENTAVOS=5990

# Quantos dias cada assinatura libera.
PLANO_DIAS=30

# Servidores liberados DE GRACA (amigos/cortesia), alem do comando no bot
# (/master cortesia). Exemplo: 123456789012345678,987654321098765432
CORTESIA_GUILD_IDS=
